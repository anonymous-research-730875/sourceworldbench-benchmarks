# Copy this file to `.env` and fill in your values.
#
# GitHub token used to authenticate GitHub API requests during golden-commit
# identification for SWE-rebench datapoints (see docs/PIPELINE.md and
# src/sourceworldbench_benchmarks/swerebench/golden_commit.py).
#
# Without a token, GitHub allows only ~60 unauthenticated requests/hour, which is
# far too low for bulk identification. A token raises the limit to ~5,000/hour.
#
# Most runs need NO token: golden commits for the verified part of SWE-rebench are
# already precomputed and committed to data/cache/rebench_golden_commits.jsonl.
# Identification returns a cache hit for those instances and never touches GitHub.
# A token is only needed for NEW datapoints not in the cache, or when recomputing
# without the cache (cache_path=None).
#
# The token needs no special scopes for public repositories (a classic token with
# no scopes, or a fine-grained token with public-repo read access, is enough).
# Create one at: https://github.com/settings/tokens
#
# GITHUB_TOKEN is checked first, then GH_TOKEN — set either one.
GITHUB_TOKEN=
# GH_TOKEN=

# LiteLLM gateway credentials, used by scripts/workloads_llm.py to generate
# amplified memory workloads (one LLM call per base/fixed pair).
# Get a key at https://litellm.xxx/ui/.
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.xxx
